{
  "name": "GitHub Dark",
  "description": "Classic GitHub dark theme — easy on the eyes for long sessions.",
  "vars": {
    "--bg":                "#0d1117",
    "--bg-alt":            "#161b22",
    "--bg-sidebar":        "#0d1117",
    "--bg-code":           "#161b22",
    "--fg":                "#e6edf3",
    "--fg-muted":          "#7d8590",
    "--border":            "#30363d",
    "--border-strong":     "#484f58",
    "--accent":            "#2f81f7",
    "--accent-bg":         "#1f6feb33",
    "--hover":             "#21262d",
    "--selected":          "#1f6feb33",
    "--shadow":            "0 1px 3px rgba(0,0,0,0.5)",
    "--md-fg":             "#e6edf3",
    "--md-link":           "#58a6ff",
    "--md-code-bg":        "#161b22",
    "--md-blockquote-border": "#30363d",
    "--content-max":       "720px",
    "--md-padding-x":      "32px",
    "--md-padding-y":      "32px",
    "--md-line-height":    "1.75",
    "--md-h1-size":        "2em",
    "--md-h2-size":        "1.5em",
    "--md-h3-size":        "1.25em",
    "--md-table-top":      "2px solid #e6edf3",
    "--md-table-mid":      "1px solid #e6edf3",
    "--md-table-bottom":   "2px solid #e6edf3",
    "--md-table-align":    "center",
    "--mdview-md-font-family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif",
    "--mdview-md-font-size":   "15px",
    "--md-heading-weight": "600",
    "--md-h2-border":      "1px solid #30363d",
    "--md-h1-border":      "1px solid #30363d"
  }
}
{
  "name": "GitHub Light",
  "description": "Classic GitHub light theme — clean, readable, technical docs friendly.",
  "vars": {
    "--bg":                "#ffffff",
    "--bg-alt":            "#f6f8fa",
    "--bg-sidebar":        "#f6f8fa",
    "--bg-code":           "#f6f8fa",
    "--fg":                "#1f2328",
    "--fg-muted":          "#57606a",
    "--border":            "#d0d7de",
    "--border-strong":     "#afb8c1",
    "--accent":            "#0969da",
    "--accent-bg":         "#ddf4ff",
    "--hover":             "#eaeef2",
    "--selected":          "#0969da33",
    "--shadow":            "0 1px 3px rgba(0,0,0,0.05)",
    "--md-fg":             "#1f2328",
    "--md-link":           "#0969da",
    "--md-code-bg":        "#f6f8fa",
    "--md-blockquote-border": "#d0d7de",
    "--content-max":       "720px",
    "--md-padding-x":      "32px",
    "--md-padding-y":      "32px",
    "--md-line-height":    "1.75",
    "--md-h1-size":        "2em",
    "--md-h2-size":        "1.5em",
    "--md-h3-size":        "1.25em",
    "--md-table-top":      "2px solid #1f2328",
    "--md-table-mid":      "1px solid #1f2328",
    "--md-table-bottom":   "2px solid #1f2328",
    "--md-table-align":    "center",
    "--mdview-md-font-family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif",
    "--mdview-md-font-size":   "15px",
    "--md-heading-weight": "600",
    "--md-h2-border":      "1px solid #d0d7de",
    "--md-h1-border":      "1px solid #d0d7de"
  }
}